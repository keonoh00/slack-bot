# Copy to .env.dev (poe dev-* tasks) or .env.prod (poe prod-celery) and fill in.
# The API and the worker both need every variable that is not marked optional.

# Slack app: OAuth & Permissions -> Bot User OAuth Token, Basic Information -> Signing Secret
SLACK_CODE_MASTER_BOT_TOKEN=xoxb-your-bot-token
SLACK_CODE_MASTER_SIGNING_SECRET=your-signing-secret

# Celery broker, also used to drop Slack's redeliveries of the same event
REDIS_URL=redis://localhost:6379/0

# OpenAI-compatible chat endpoint with tool calling (vLLM in docker-compose.yaml).
# VLLM_API_KEY is also the key the vLLM container requires from clients.
VLLM_API_KEY=change-me
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8

# Document search
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdfs
QDRANT_EMBEDDING_MODEL_NAME=nlpai-lab/KURE-v3

# docker-compose.yaml. vLLM is published on 8001 here so it does not collide with
# the API on 8000 when both run on one machine.
VLLM_PORT=8001
# Optional: address the containers listen on (default 127.0.0.1). Never 0.0.0.0:
# Redis and Qdrant have no authentication.
# DOCKER_BIND_ADDRESS=127.0.0.1
# Optional vLLM settings
# VLLM_GPUS=0
# VLLM_MAX_LEN=32768
# VLLM_TOOL_CALL_PARSER=qwen3_coder
# HF_HOME=/path/to/huggingface-cache

# Optional: Cloudflare Tunnel token for `poe dev-tunnel`
# CLOUDFLARE_TUNNEL_TOKEN=
